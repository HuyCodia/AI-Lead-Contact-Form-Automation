            {
              "id": "2ff1fcf0-50ba-4050-aa7b-c099bbae3362",
              "name": "Email Body",
              "value": "=\n{{\n(() => {\n  const priority = ($json.output.priority || \"LOW\").toUpperCase();\n\n  const colors = {\n    LOW: [\"#DCFCE7\", \"#166534\", \"#22C55E\"],\n    MEDIUM: [\"#FFEDD5\", \"#9A3412\", \"#F97316\"],\n    HIGH: [\"#FEE2E2\", \"#991B1B\", \"#EF4444\"]\n  };\n\n  const [bg, color, border] = colors[priority] || colors.LOW;\n\n  const safe = (value) => String(value ?? \"\")\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#039;\");\n\n  return `\n  <div style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.6; max-width: 700px;\">\n\n    <p>Hello Sales Team,</p>\n\n    <p>A new sales inquiry has been received and analyzed by our AI-powered contact management system.</p>\n\n    <h3>CUSTOMER INFORMATION</h3>\n    <p>\n      <strong>Name:</strong> ${safe($json[\"Full Name\"])}<br>\n      <strong>Email:</strong> ${safe($json[\"Email Address\"])}<br>\n      <strong>Company:</strong> ${safe($json.Company)}<br>\n      <strong>Received at:</strong> ${safe($json.submittedAt)}\n    </p>\n\n    <h3>INQUIRY DETAILS</h3>\n    <p><strong>Subject:</strong> ${safe($json.Subject)}</p>\n\n    <p><strong>Original Message:</strong></p>\n    <div style=\"background: #f5f5f5; padding: 12px; border-radius: 6px; white-space: pre-wrap;\">${safe($json.Message)}</div>\n\n    <h3>AI ANALYSIS</h3>\n    <p><strong>Category:</strong> ${safe($json.output.category)}</p>\n\n    <p><strong>Priority:</strong><br>\n      <span style=\"display:inline-block; background:${bg}; color:${color}; border:1px solid ${border}; padding:5px 14px; border-radius:5px; font-weight:bold;\">\n        ${safe(priority)}\n      </span>\n    </p>\n\n    <p><strong>Sentiment:</strong> ${safe($json.output.sentiment)}</p>\n\n    <p><strong>AI Summary:</strong><br>${safe($json.output.summary)}</p>\n\n    <p><strong>Recommended Next Step:</strong><br>${safe($json.output.recommended_next_step)}</p>\n\n    <hr>\n    <p>Please review this inquiry and follow up with the potential customer.</p>\n\n    <p>Best regards,<br><strong>AI Contact Management System</strong></p>\n\n  </div>\n  `;\n})()\n}}\n",
              "type": "string"
